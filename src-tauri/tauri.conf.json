{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "taffy",
  "version": "0.1.0",
  "identifier": "com.taffy.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "taffy",
        "width": 1120,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false, "icon": [] }
}
